#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# CocoaPods lock files — regenerated by `pod install` on each machine.
# The Podfiles themselves stay tracked; only the per-machine locks are ignored.
/ios/Podfile.lock
/macos/Podfile.lock

# Local build artifacts staged by bin/aadnanda-*.sh (they live in ~/Documents/GitHub/)
*.ipa
*.apk
*.aab
